// The shared data Worker (worker/data-service.ts): accounts, friends, share codes and reports for production
// and every preview of the app (Trevor, 2026-10-19). The app reaches it only through its
// `DATA` service binding, so it has no workers.dev or preview address of its own.
// Workers Builds deploys it as its own Worker, with this file as its config.
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "grim-games-data",
	"main": "worker/data-service.ts",
	"compatibility_date": "2026-10-01",
	"workers_dev": false,
	"preview_urls": false,
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
		"logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": true, "persist": true }
	},
	"durable_objects": {
		"bindings": [
			{ "name": "ACCOUNT_USERS", "class_name": "AccountUser" },
			{ "name": "ACCOUNT_EMAILS", "class_name": "AccountEmail" },
			{ "name": "ACCOUNT_NAMES", "class_name": "AccountName" },
			{ "name": "SHARED_SCRIPTS", "class_name": "SharedScript" },
			{ "name": "REPORTS", "class_name": "ReportBox" },
			// Each account's friends, requests and blocks (worker/friends/book.ts).
			{ "name": "FRIEND_BOOKS", "class_name": "FriendBook" },
			// Every account's id, for the admins' Accounts list (worker/account/objects/directory.ts).
			{ "name": "ACCOUNT_DIRECTORY", "class_name": "AccountDirectory" }
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"AccountUser",
				"AccountEmail",
				"AccountName",
				"SharedScript",
				"ReportBox"
			]
		},
		{ "tag": "v2", "new_sqlite_classes": ["FriendBook"] },
		{ "tag": "v3", "new_sqlite_classes": ["AccountDirectory"] }
	]
}
