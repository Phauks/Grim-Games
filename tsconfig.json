{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"strict": true,
		"types": ["$app/types", "node"]
	},
	"include": [
		"src",
		"e2e",
		"scripts",
		"build-info.ts",
		"svelte-nested-flush.ts",
