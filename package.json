{
	"name": "grim-games",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "npm run build && wrangler dev",
		"prepare": "svelte-kit sync || echo \"\"",
		"cf-typegen": "wrangler types worker/worker-configuration.d.ts --include-env=false",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && npm run check:worker",
		"check:worker": "npm run cf-typegen && tsc -p worker/tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint . && npm run lint:colors",
		"lint:colors": "node scripts/check-colors.ts --run",
		"format": "prettier --write .",
		"icons": "node scripts/generate-icons.ts --write",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright test",
		"deploy": "npm run build && wrangler deploy",
		"deploy:staging": "npm run build && wrangler deploy --env staging"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@iconify-json/ph": "1.2.2",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^22",
		"@vitest/browser-playwright": "^4.1.8",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"playwright": "^1.60.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"unplugin-icons": "24.0.0",
		"vite": "^8.3.0",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1",
		"wrangler": "^4.151.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"description": "Touch-first Storyteller grimoire for Blood on the Clocktower",
	"engines": {
		"node": ">=22"
	},
	"dependencies": {
		"@ark-ui/svelte": "5.24.3",
		"@fontsource/atkinson-hyperlegible-next": "5.3.0",
		"@fontsource/cinzel": "5.3.0",
		"@fontsource/eb-garamond": "5.3.0",
		"@fontsource/im-fell-english-sc": "5.3.0",
		"@fontsource/inter": "5.3.0",
		"@fontsource/lexend": "5.3.0"
	}
}
