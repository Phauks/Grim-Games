{
	"name": "grim-games",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "npm run build && wrangler dev -c wrangler.jsonc -c wrangler.data.jsonc",
		"prepare": "svelte-kit sync || echo \"\" && git config core.hooksPath .githooks || echo \"\"",
		"cf-typegen": "wrangler types worker/worker-configuration.d.ts --include-env=false",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && tsc -p tsconfig.service-worker.json --noEmit && npm run check:worker",
		"check:worker": "npm run cf-typegen && tsc -p worker/tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint . && npm run lint:colors && npm run lint:px && npm run lint:layers && npm run lint:separators && npm run lint:lines && npm run lint:knip && npm run lint:knip:prod && npm run check:rules-coverage",
		"lint:colors": "node scripts/check-colors.ts --run",
		"lint:px": "node scripts/check-px.ts --run",
		"lint:layers": "node scripts/check-layers.ts --run",
		"lint:separators": "node scripts/check-separators.ts --run",
		"lint:lines": "node scripts/check-lines.ts --run",
		"lint:knip": "knip --no-progress",
		"lint:knip:prod": "node scripts/check-knip-prod.ts --run",
		"check:rules-coverage": "node scripts/check-rules-coverage.ts",
		"check:parity": "node scripts/check-parity.ts",
		"format": "prettier --write .",
		"icons": "node scripts/generate-icons.ts --write",
		"parts:catalogue": "node scripts/generate-parts-catalogue.ts --write",
		"test:unit": "vitest",
		"verify": "npm run check && npm run lint && npm run test:unit -- --run && npm run check:parity",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright test",
		"deploy": "npm run build && wrangler deploy",
		"deploy:staging": "npm run build && wrangler deploy --env staging",
		"sync:data": "node scripts/sync-data.ts",
		"bots": "node scripts/room-bots.ts",
		"scaffold:rules-tests": "node scripts/scaffold-rules-tests.ts",
		"export:setup-prep": "node scripts/export-setup-prep.ts",
		"export:reminder-placeholders": "node scripts/export-reminder-placeholders.ts"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@iconify-json/ph": "1.2.2",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tesseract.js-data/eng": "1.0.0",
		"@types/node": "^22",
		"@types/three": "^0.186.0",
		"@vitest/browser-playwright": "^4.1.8",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"knip": "^6.42.1",
		"pdfjs-dist": "6.4.299",
		"playwright": "^1.60.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"unplugin-icons": "24.0.0",
		"vite": "^8.3.0",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1",
		"wrangler": "^4.156.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"description": "Touch-first Storyteller grimoire for Blood on the Clocktower",
	"engines": {
		"node": ">=22"
	},
	"dependencies": {
		"@ark-ui/svelte": "5.24.3",
		"@fontsource/atkinson-hyperlegible-next": "5.3.0",
		"@fontsource/cinzel": "5.3.0",
		"@fontsource/eb-garamond": "5.3.0",
		"@fontsource/im-fell-english-sc": "5.3.0",
		"@fontsource/inter": "5.3.0",
		"@fontsource/lexend": "5.3.0",
		"@jridgewell/trace-mapping": "0.3.31",
		"@threlte/core": "^8.6.1",
		"jsqr": "1.4.0",
		"modern-screenshot": "4.7.0",
		"tesseract.js": "7.0.0",
		"three": "^0.186.1",
		"tone": "15.1.22",
		"uqr": "0.1.3"
	}
}
