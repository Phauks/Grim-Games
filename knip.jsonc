{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	// Run by `npm run lint:knip`: files, exports and dependencies nothing uses.
	"entry": ["worker/data-service.ts!", "scripts/*.ts", "scripts/lint/*.js", "e2e/**/*.ts"],
	"project": [
		"src/**/*.{ts,svelte}!",
		"!src/**/*.test-support.ts!",
		"!src/lib/core/testing/**!",
		"worker/**/*.ts!",
		"scripts/**/*.{ts,js}",
		"e2e/**/*.ts"
	],
	// Written by `npm run cf-typegen` when the Worker is checked.
	"ignoreUnresolved": ["./worker-configuration.d.ts"],
	// The Worker runtime's own modules (cloudflare:workers).
	// The photo reader's English data is read by path from node_modules (vite.config.ts ocrFiles).
	"ignoreDependencies": ["cloudflare", "@tesseract.js-data/eng"],
	// An export the file itself uses (a list behind its type, say) is fine.
	"ignoreExportsUsedInFile": true,
	// Exported types document a module's shapes; only values are checked.
	"rules": { "types": "off" }
}
