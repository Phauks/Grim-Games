// One Worker serves the static SvelteKit build and the /api routes, and hosts the
// Room Durable Object for live sync (04-architecture.md §1, 05-spike-results.md S2).
// Cloudflare Workers Builds deploys it from GitHub: `main` -> production, other branches -> Previews.
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "grim-games",
	"main": "worker/index.ts",
	"compatibility_date": "2026-10-01",
	// Observability settings supplied by Trevor from the Cloudflare dashboard (2026-10-15).
	// Query strings are kept in logs; nothing private travels in them (room codes are in the path).
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
		"redact_query_string": false,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"invocation_logs": true,
			"persist": true
		},
		"traces": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true
		},
		// The dashboard snippet said "issue_detection"; wrangler 4.151 and the Issues docs
		// (developers.cloudflare.com/workers/observability/issues/) use "issues".
		"issues": {
			"enabled": true
		}
	},
	"assets": {
		"directory": "./build",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*"]
	},
	// Room (live sync), SharedScript (share codes), and for accounts (07-accounts-and-multi-device.md
	// §2.1) AccountUser and AccountEmail. SQLite Durable Objects need nothing created by hand.
	"durable_objects": {
		"bindings": [
			{ "name": "ROOMS", "class_name": "Room" },
			{ "name": "SHARED_SCRIPTS", "class_name": "SharedScript" },
			{ "name": "ACCOUNT_USERS", "class_name": "AccountUser" },
			{ "name": "ACCOUNT_EMAILS", "class_name": "AccountEmail" }
		]
	},
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["Room"] },
		{ "tag": "v2", "new_sqlite_classes": ["SharedScript"] },
		{ "tag": "v3", "new_sqlite_classes": ["AccountUser", "AccountEmail"] }
	],
	// Script share codes (worker/share.ts): per-address limits so codes can't be guessed by
	// trying many. namespace_id is our own number; nothing to create in the dashboard
	// (developers.cloudflare.com/workers/runtime-apis/bindings/rate-limit/).
	"ratelimits": [
		{ "name": "SHARE_LOOKUPS", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
		{ "name": "SHARE_CREATES", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } },
		// Sign-in codes requested per address (worker/account/routes.ts).
		{ "name": "AUTH_STARTS", "namespace_id": "1003", "simple": { "limit": 20, "period": 60 } },
		// Live rooms (worker/room.ts): joins and reconnects, and rooms opened, per address.
		{ "name": "ROOM_JOINS", "namespace_id": "1004", "simple": { "limit": 60, "period": 60 } },
		{ "name": "ROOM_CREATES", "namespace_id": "1005", "simple": { "limit": 20, "period": 60 } }
	],
	"vars": { "ENVIRONMENT": "production" },
	// Worker Previews: Workers Builds runs `npx wrangler preview` for non-production branches,
	// giving each branch/PR its own URL on this same Worker, with its own Durable Object
	// namespace and storage. Previews don't inherit vars or bindings, so they're repeated here.
	"previews": {
		"vars": { "ENVIRONMENT": "preview" },
		"durable_objects": {
			"bindings": [
				{ "name": "ROOMS", "class_name": "Room" },
				{ "name": "SHARED_SCRIPTS", "class_name": "SharedScript" },
				{ "name": "ACCOUNT_USERS", "class_name": "AccountUser" },
				{ "name": "ACCOUNT_EMAILS", "class_name": "AccountEmail" }
			]
		},
		"ratelimits": [
			{ "name": "SHARE_LOOKUPS", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
			{ "name": "SHARE_CREATES", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } },
			{ "name": "AUTH_STARTS", "namespace_id": "1003", "simple": { "limit": 20, "period": 60 } },
			{ "name": "ROOM_JOINS", "namespace_id": "1004", "simple": { "limit": 60, "period": 60 } },
			{ "name": "ROOM_CREATES", "namespace_id": "1005", "simple": { "limit": 20, "period": 60 } }
		]
	}
}
