// One Worker serves the static SvelteKit build and the /api routes, and hosts the
// Room Durable Object for live sync (04-architecture.md §1, 05-spike-results.md S2).
// Cloudflare Workers Builds deploys it from GitHub: `main` -> production, `beta` -> a Preview.
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "grim-games",
	"main": "worker/index.ts",
	"compatibility_date": "2026-10-01",
	// Observability settings supplied by Trevor from the Cloudflare dashboard (2026-10-15).
	// Query strings are kept in logs; nothing private travels in them (room codes are in the path).
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
		"redact_query_string": false,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"invocation_logs": true,
			"persist": true
		},
		"traces": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true
		},
		// The dashboard snippet said "issue_detection"; wrangler 4.151 and the Issues docs
		// (developers.cloudflare.com/workers/observability/issues/) use "issues".
		"issues": {
			"enabled": true
		}
	},
	"assets": {
		"directory": "./build",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*"]
	},
	// Room (live sync), SharedScript (share codes), and for accounts (07-accounts-and-multi-device.md
	// §2.1) AccountUser, AccountEmail and AccountName (usernames). SQLite Durable Objects need nothing created by hand.
	"durable_objects": {
		"bindings": [
			{ "name": "ROOMS", "class_name": "Room" },
			{ "name": "SHARED_SCRIPTS", "class_name": "SharedScript" },
			{ "name": "ACCOUNT_USERS", "class_name": "AccountUser" },
			{ "name": "ACCOUNT_EMAILS", "class_name": "AccountEmail" },
			{ "name": "ACCOUNT_NAMES", "class_name": "AccountName" },
			{ "name": "REPORTS", "class_name": "ReportBox" },
			// Our copies of other sites' script lists (worker/mirror.ts).
			{ "name": "SCRIPT_MIRROR", "class_name": "ScriptMirror" },
			// Game recaps the Storyteller shares with the players (worker/recap.ts).
			{ "name": "RECAPS", "class_name": "SharedRecap" },
			// The open rooms' codes, for the admins' Live games (worker/live-games.ts).
			{ "name": "LIVE_GAMES", "class_name": "LiveGameIndex" }
		]
	},
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["Room"] },
		{ "tag": "v2", "new_sqlite_classes": ["SharedScript"] },
		{ "tag": "v3", "new_sqlite_classes": ["AccountUser", "AccountEmail"] },
		{ "tag": "v4", "new_sqlite_classes": ["ReportBox"] },
		{ "tag": "v5", "new_sqlite_classes": ["ScriptMirror"] },
		{ "tag": "v6", "new_sqlite_classes": ["AccountName"] },
		{ "tag": "v7", "new_sqlite_classes": ["SharedRecap"] },
		{ "tag": "v8", "new_sqlite_classes": ["LiveGameIndex"] }
	],
	// Nightly refresh of the stored script copies (worker/mirror.ts). Previews run no
	// schedule; there a copy is refreshed when it is asked for and over a day old.
	"triggers": { "crons": ["17 4 * * *"] },
	// Script share codes (worker/share.ts): per-address limits so codes can't be guessed by
	// trying many. namespace_id is our own number; nothing to create in the dashboard
	// (developers.cloudflare.com/workers/runtime-apis/bindings/rate-limit/).
	"ratelimits": [
		{ "name": "SHARE_LOOKUPS", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
		{ "name": "SHARE_CREATES", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } },
		// Sign-in codes requested per address (worker/account/routes.ts).
		{ "name": "AUTH_STARTS", "namespace_id": "1003", "simple": { "limit": 20, "period": 60 } },
		// Live rooms (worker/room.ts): joins and reconnects, and rooms opened, per address.
		{ "name": "ROOM_JOINS", "namespace_id": "1004", "simple": { "limit": 60, "period": 60 } },
		{ "name": "ROOM_CREATES", "namespace_id": "1005", "simple": { "limit": 20, "period": 60 } },
		{ "name": "REPORT_CREATES", "namespace_id": "1006", "simple": { "limit": 5, "period": 60 } },
		// Password sign-ins tried per address, on top of the per-email limit in AccountEmail.
		{ "name": "AUTH_PASSWORDS", "namespace_id": "1007", "simple": { "limit": 10, "period": 60 } }
	],
	// The site is served on grimbinder.com (Trevor, 2026-10-18), attached as a Custom Domain in
	// the Cloudflare dashboard. It is deliberately not listed under "routes": wrangler only
	// touches custom domains when the config lists some, and then replaces the whole set, so
	// dashboard settings (such as previews on the domain) stay as Trevor set them. Switching
	// domains later: attach the new one in the dashboard and change EMAIL_FROM below; sign-in
	// links use whatever address the request came in on (worker/account/routes.ts).
	// Sign-in emails (worker/account/email.ts) through Cloudflare Email Service; grimbinder.com
	// must be onboarded under Email Sending first. Previews don't inherit this binding, so
	// they keep showing the code on screen instead of sending email.
	"send_email": [{ "name": "EMAIL" }],
	"vars": { "ENVIRONMENT": "production", "EMAIL_FROM": "sign-in@grimbinder.com" },
	// Accounts, share codes and reports live in the shared data Worker (wrangler.data.jsonc,
	// worker/shared-data.ts), so production and every preview see the same ones. A preview's
	// binding reaches that Worker's production deployment.
	"services": [{ "binding": "DATA", "service": "grim-games-data" }],
	// Worker Previews: Workers Builds' non-production deploy command runs `npx wrangler preview`
	// only for beta (see README), because each Preview owns its own Durable Object namespaces
	// and the account allows 500. The Preview gets its own URL on this same Worker and its own
	// storage. Previews don't inherit vars or bindings, so they're repeated here.
	"previews": {
		// The beta preview sends real sign-in email from the same address (account/email.ts);
		// other previews show the code on screen.
		"vars": { "ENVIRONMENT": "preview", "EMAIL_FROM": "sign-in@grimbinder.com" },
		"send_email": [{ "name": "EMAIL" }],
		"services": [{ "binding": "DATA", "service": "grim-games-data" }],
		"durable_objects": {
			"bindings": [
				{ "name": "ROOMS", "class_name": "Room" },
				{ "name": "SHARED_SCRIPTS", "class_name": "SharedScript" },
				{ "name": "ACCOUNT_USERS", "class_name": "AccountUser" },
				{ "name": "ACCOUNT_EMAILS", "class_name": "AccountEmail" },
				{ "name": "ACCOUNT_NAMES", "class_name": "AccountName" },
				{ "name": "REPORTS", "class_name": "ReportBox" },
				{ "name": "SCRIPT_MIRROR", "class_name": "ScriptMirror" },
				{ "name": "RECAPS", "class_name": "SharedRecap" },
				{ "name": "LIVE_GAMES", "class_name": "LiveGameIndex" }
			]
		},
		"ratelimits": [
			{ "name": "SHARE_LOOKUPS", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
			{ "name": "SHARE_CREATES", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } },
			{ "name": "AUTH_STARTS", "namespace_id": "1003", "simple": { "limit": 20, "period": 60 } },
			{ "name": "ROOM_JOINS", "namespace_id": "1004", "simple": { "limit": 60, "period": 60 } },
			{ "name": "ROOM_CREATES", "namespace_id": "1005", "simple": { "limit": 20, "period": 60 } },
			{ "name": "REPORT_CREATES", "namespace_id": "1006", "simple": { "limit": 5, "period": 60 } },
			{ "name": "AUTH_PASSWORDS", "namespace_id": "1007", "simple": { "limit": 10, "period": 60 } }
		]
	}
}
