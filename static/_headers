# Cloudflare static asset headers (developers.cloudflare.com/workers/static-assets/headers/).
# Build files carry a content hash in their names, so a browser can keep them for a year
# without asking again; everything else keeps the default revalidation.
/_app/immutable/*
  Cache-Control: public, max-age=31536000, immutable

# Every page: the browser never guesses a file's type, other sites can't show the app in a
# frame (the app's own frames, such as the Test room's phones, still can), and links to other
# sites send only our origin.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: frame-ancestors 'self'
  Referrer-Policy: strict-origin-when-cross-origin
