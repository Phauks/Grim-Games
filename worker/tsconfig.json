{
	"compilerOptions": {
		"target": "es2024",
		"module": "es2022",
		"moduleResolution": "bundler",
		"lib": ["es2024"],
		"types": ["./worker-configuration.d.ts"],
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"isolatedModules": true,
		"allowImportingTsExtensions": true
	},
	"include": [
		"./**/*.ts",
		"../src/lib/core/**/*.ts",
		"../src/lib/features/scripts/botcscripts-api.ts",
		"../src/lib/features/scripts/share-codes-api.ts"
	],
	"exclude": [
		"../src/lib/core/**/*.test.ts",
		"../src/lib/core/**/*.test-support.ts",
		"../src/lib/core/testing/**"
	]
}
