// The shared accounts Worker (worker/accounts-service.ts): one set of accounts for production
// and every preview of the app (Trevor, 2026-10-18). The app reaches it only through its
// `ACCOUNTS` service binding, so it has no workers.dev or preview address of its own.
// Workers Builds deploys it as its own Worker, with this file as its config.
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "grim-games-accounts",
	"main": "worker/accounts-service.ts",
	"compatibility_date": "2026-10-01",
	"workers_dev": false,
	"preview_urls": false,
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
		"logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": true, "persist": true }
	},
	"durable_objects": {
		"bindings": [
			{ "name": "ACCOUNT_USERS", "class_name": "AccountUser" },
			{ "name": "ACCOUNT_EMAILS", "class_name": "AccountEmail" },
			{ "name": "ACCOUNT_NAMES", "class_name": "AccountName" }
		]
	},
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["AccountUser", "AccountEmail", "AccountName"] }
	]
}
